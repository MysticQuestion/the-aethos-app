{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.app/schemas/canonical/aethos.dignity_state.v1.json",
  "title": "Dignity State (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "sign", "status"],
  "properties": {
    "body": { "$ref": "https://aethos.app/schemas/canonical/aethos.body_enum.v1.json" },
    "sign": { "type": "string", "enum": ["Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces"] },
    "status": { "type": "string", "enum": ["domicile", "exaltation", "detriment", "fall", "peregrine"] }
  }
}
