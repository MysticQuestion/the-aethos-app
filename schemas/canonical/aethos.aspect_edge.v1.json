{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.app/schemas/canonical/aethos.aspect_edge.v1.json",
  "title": "Aspect Edge (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["body_a", "body_b", "aspect", "exact_angle", "separation", "orb", "applying", "strength"],
  "properties": {
    "body_a": { "$ref": "https://aethos.app/schemas/canonical/aethos.body_enum.v1.json" },
    "body_b": { "$ref": "https://aethos.app/schemas/canonical/aethos.body_enum.v1.json" },
    "aspect": { "type": "string", "enum": ["conjunction", "opposition", "trine", "square", "sextile", "quincunx"] },
    "exact_angle": { "type": "number", "minimum": 0, "maximum": 180 },
    "separation": { "type": "number", "minimum": 0, "maximum": 180 },
    "orb": { "type": "number", "minimum": 0, "maximum": 30 },
    "applying": { "type": "boolean" },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
